# للتجربة المحلية فقط. على Fly استخدم: fly secrets set NAME=value
# لا ترفع ملف .env الحقيقي إلى أي مستودع.

TELEGRAM_TOKEN=
# معرّفات تيليجرام للمديرين (أرقام). يعرف كل شخص معرّفه بالأمر /myid
MANAGER_IDS=
# رمز سري طويل عشوائي. يُضبط بنفس القيمة في بوت العميل باسم SALES_INGEST_TOKEN
INGEST_TOKEN=
DB_PATH=./data/sales.db

# اختياري
ASSIGN_MODE=balanced
BRIEF_HOUR=8
WORK_DAYS=6,0,1,2,3
ALERT_UNCONTACTED_HOURS=
STOCK_STALE_HOURS=48
PROTECT_CONTENT=1
TIMEZONE=Asia/Riyadh

# قراءة من أودو (مقفولة ما لم تُضبط الأربعة الأولى). مستخدم للقراءة فقط
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
STOCK_SOURCE=file
